# عنوان مشروع Supabase (Project URL) — من Project Settings > API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# المفتاح العام (anon / publishable key) — آمن للواجهة لأن الحماية في سياسات RLS
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# اختياري: الرابط العام للتطبيق المستخدم في روابط الانضمام ورمز QR (افتراضيًا عنوان الصفحة الحالية)
VITE_PUBLIC_APP_URL=
# تحذير: لا تضع service_role key هنا أبدًا؛ أي متغير يبدأ بـ VITE_ يصل إلى المتصفح.
